# Supabase -> Project Settings -> Database -> Connection string -> URI
# Use the session/direct connection (port 5432). Keep this secret; never commit .env.
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@HOST:5432/postgres?sslmode=require

POINTS_PER_RECEIPT=10
MIN_RECEIPT_AMOUNT=20
DAILY_POINTS_CAP=50
TURNOVER_TAX_RATE=0.05
ADMIN_TOKEN=dev-admin-token
CORS_ORIGINS=*
